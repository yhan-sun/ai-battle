{
  "name": "ai-battle",
  "version": "1.0.0",
  "private": true,
  "description": "AI 大模型极限前端编程能力比拼 - 天天酷跑 3D/2.5D 横版跑酷游戏",
  "scripts": {
    "dev:openai": "npm --prefix openai/gpt-5.6-luna-max run dev",
    "dev:google": "npm --prefix google/gemini-3.8-flash-high run dev",
    "dev:meta": "npm --prefix meta/muse-spark-1.3 run dev",
    "dev:teleagent": "npm --prefix teleagent/pro run dev",
    "test": "node scripts/verify-projects.mjs",
    "test:ui": "node --test scripts/verify-ui.mjs",
    "test:submission": "node scripts/verify-submission.mjs",
    "sync:readme": "node scripts/sync-readme.mjs",
    "install:projects": "node scripts/install-projects.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:all": "node scripts/build-projects.mjs"
  },
  "keywords": [
    "ai-battle",
    "threejs",
    "runner-game",
    "game-dev",
    "gemini",
    "gpt",
    "claude",
    "benchmark"
